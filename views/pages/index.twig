<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeachLab Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'teachlab-blue': '#4F46E5',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-sans">
    <!-- Mobile overlay for sidebar -->
    <div id="mobile-overlay" class="lg:hidden fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>
    
    <div class="flex min-h-screen">
        <!-- Unified responsive sidebar that works for both desktop and mobile -->
        <div id="sidebar" class=" w-64  bg-white shadow-sm border-r border-gray-200 fixed lg:relative  overflow-y-auto z-50 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
            <div class="h-screen flex flex-col">
                <!-- Logo -->
                <div class="p-6 pb-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <!--<div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
                                <span class="text-white font-bold text-sm">TL</span>
                            </div> -->
                            <!--<span class="text-xl font-semibold text-gray-900">TeachLab</span> -->
                            <img src="/assets/img/logo.png" alt="Teachlabs Logo" width='140'>
                        </div>
                        <!-- Close button only visible on mobile -->
                        <button id="close-sidebar" class="lg:hidden p-1 text-gray-600 hover:text-gray-900">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Navigation -->
                <nav class="px-6 space-y-2 flex-1 mt-4">
                    <a href="#" class="flex items-center px-3 py-2 text-blue-600 bg-blue-50 rounded-lg font-medium">
                        <i class="fas fa-th-large mr-3 w-5"></i>
                        Dashboard
                    </a>
                    <a href="#" class="flex items-center px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg">
                        <i class="fas fa-book mr-3 w-5"></i>
                        Courses
                    </a>
                    <a href="#" class="flex items-center px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg">
                        <i class="fas fa-users mr-3 w-5"></i>
                        Students
                    </a>
                    <a href="#" class="flex items-center px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg">
                        <i class="fas fa-calendar-check mr-3 w-5"></i>
                        Attendance
                    </a>
                    <a href="#" class="flex items-center px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg">
                        <i class="fas fa-clipboard-list mr-3 w-5"></i>
                        Assignments
                    </a>
                    <a href="#" class="flex items-center px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg">
                        <i class="fas fa-question-circle mr-3 w-5"></i>
                        Quizzes
                    </a>
                    <a href="#" class="flex items-center px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg">
                        <i class="fas fa-graduation-cap mr-3 w-5"></i>
                        Exams
                    </a>
                </nav>

                <!-- Upgrade Card -->
                <div class="p-6 pt-4">
                    <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg p-4 text-white">
                        <div class="flex items-center mb-2">
                            <i class="fas fa-crown text-yellow-300 mr-2"></i>
                            <span class="font-semibold text-sm">Upgrade to Pro</span>
                        </div>
                        <p class="text-xs text-blue-100 mb-3">Unlock advanced features and analytics</p>
                        <button class="w-full bg-white text-blue-600 text-sm font-medium py-2 px-3 rounded-md hover:bg-blue-50 transition-colors">
                            Upgrade Now
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <!-- Adjusted margin for responsive sidebar -->
        <div class="flex-1 lg:ml-0">
            <!-- Header -->
            <header class="bg-white border-b border-gray-200 px-6 py-4 sticky top-0 z-30">
                <div class="flex items-center justify-between">
                    <!-- Mobile menu button moved to header -->
                    <div class="flex items-center">
                        <button id="mobile-menu-btn" class="lg:hidden p-2 mr-3 text-gray-600 hover:text-gray-900">
                            <i class="fas fa-bars text-lg"></i>
                        </button>
                        
                    </div>
                    <div class="flex items-center space-x-4">
                        <!-- Notification Dropdown -->
                        <div class="relative">
                            <button id="notification-btn" class="p-2 text-gray-600 hover:text-gray-900 relative">
                                <i class="fas fa-bell text-lg"></i>
                                <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center">3</span>
                            </button>
                            <div id="notification-dropdown" class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="p-4 border-b border-gray-200">
                                    <h3 class="text-sm font-semibold text-gray-900">Notifications</h3>
                                </div>
                                <div class="max-h-64 overflow-y-auto">
                                    <div class="p-4 hover:bg-gray-50 border-b border-gray-100">
                                        <div class="flex items-start space-x-3">
                                            <div class="w-2 h-2 bg-blue-500 rounded-full mt-2"></div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900">New assignment submitted</p>
                                                <p class="text-xs text-gray-500">CS301 - Database Design Project</p>
                                                <p class="text-xs text-gray-400 mt-1">2 minutes ago</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-4 hover:bg-gray-50 border-b border-gray-100">
                                        <div class="flex items-start space-x-3">
                                            <div class="w-2 h-2 bg-green-500 rounded-full mt-2"></div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900">Quiz completed</p>
                                                <p class="text-xs text-gray-500">CS201 - Data Structures Quiz</p>
                                                <p class="text-xs text-gray-400 mt-1">1 hour ago</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-4 hover:bg-gray-50">
                                        <div class="flex items-start space-x-3">
                                            <div class="w-2 h-2 bg-orange-500 rounded-full mt-2"></div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900">Deadline reminder</p>
                                                <p class="text-xs text-gray-500">CS401 - Final Project due tomorrow</p>
                                                <p class="text-xs text-gray-400 mt-1">3 hours ago</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-3 border-t border-gray-200">
                                    <button class="w-full text-center text-sm text-blue-600 hover:text-blue-800">View all notifications</button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 hover:bg-gray-50 rounded-lg p-2">
                                <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
                                    <span class="text-white font-medium text-sm">DS</span>
                                </div>
                                <div class="hidden md:block text-left">
                                    <div class="text-sm font-medium text-gray-900">Dr. Smith</div>
                                    <div class="text-xs text-gray-500">Computer Science</div>
                                </div>
                                <i class="fas fa-chevron-down text-gray-400 text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="p-2">
                                    <a href="#" class="flex items-center px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-md">
                                        <i class="fas fa-user mr-3 w-4"></i>
                                        Profile
                                    </a>
                                    <a href="#" class="flex items-center px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-md">
                                        <i class="fas fa-cog mr-3 w-4"></i>
                                        Settings
                                    </a>
                                    <a href="#" class="flex items-center px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-md">
                                        <i class="fas fa-question-circle mr-3 w-4"></i>
                                        Help
                                    </a>
                                    <hr class="my-2">
                                    <a href="#" class="flex items-center px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-md">
                                        <i class="fas fa-sign-out-alt mr-3 w-4"></i>
                                        Sign out
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <main class="p-6">
                <!-- Dashboard Overview -->
                <div class="mb-8">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-xl font-semibold text-gray-900">Dashboard Overview</h2>
                            <p class="text-gray-600">Monitor your teaching activities and student progress</p>
                        </div>
                        <div class="text-sm text-gray-500">
                            Last updated<br>
                            <span class="font-medium">Today, 2:30 PM</span>
                        </div>
                    </div>

                    <!-- Stats Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                        <!-- Total Courses -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-600">Total Courses</p>
                                    <p class="text-3xl font-bold text-gray-900">8</p>
                                    <p class="text-sm text-gray-500">+2 this semester</p>
                                </div>
                                <div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-book text-white text-lg"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Total Students -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-600">Total Students</p>
                                    <p class="text-3xl font-bold text-gray-900">245</p>
                                    <p class="text-sm text-gray-500">+15 this month</p>
                                </div>
                                <div class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-users text-white text-lg"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Active Assignments -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-600">Active Assignments</p>
                                    <p class="text-3xl font-bold text-gray-900">12</p>
                                    <p class="text-sm text-gray-500">3 due this week</p>
                                </div>
                                <div class="w-12 h-12 bg-orange-500 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-clipboard-list text-white text-lg"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Avg Attendance -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-600">Avg Attendance</p>
                                    <p class="text-3xl font-bold text-gray-900">87%</p>
                                    <p class="text-sm text-gray-500">+5% from last month</p>
                                </div>
                                <div class="w-12 h-12 bg-purple-500 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-calendar-check text-white text-lg"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Section -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        <!-- Weekly Attendance Trend -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-900">Weekly Attendance Trend</h3>
                                <i class="fas fa-chart-line text-green-500"></i>
                            </div>
                            <div class="h-48">
                                <canvas id="attendanceChart" class="w-full h-full"></canvas>
                            </div>
                        </div>

                        <!-- Course Distribution -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-900">Course Distribution</h3>
                                <i class="fas fa-chart-pie text-blue-500"></i>
                            </div>
                            <div class="h-48 mb-4">
                                <canvas id="courseChart" class="w-full h-full"></canvas>
                            </div>
                            <div class="flex flex-wrap gap-4 justify-center">
                                <div class="flex items-center">
                                    <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
                                    <span class="text-sm text-gray-600">CS101</span>
                                </div>
                                <div class="flex items-center">
                                    <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
                                    <span class="text-sm text-gray-600">CS201</span>
                                </div>
                                <div class="flex items-center">
                                    <div class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></div>
                                    <span class="text-sm text-gray-600">CS301</span>
                                </div>
                                <div class="flex items-center">
                                    <div class="w-3 h-3 bg-purple-500 rounded-full mr-2"></div>
                                    <span class="text-sm text-gray-600">CS401</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Section -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Recent Activities -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-900">Recent Activities</h3>
                                <i class="fas fa-clock text-gray-400"></i>
                            </div>
                            <div class="space-y-4">
                                <div class="flex items-start space-x-3">
                                    <div class="w-2 h-2 bg-blue-500 rounded-full mt-2"></div>
                                    <div class="flex-1">
                                        <p class="text-sm font-medium text-gray-900">New submission for "Database Design Project"</p>
                                        <div class="flex items-center space-x-2 mt-1">
                                            <span class="text-xs text-gray-500">2 hours ago</span>
                                            <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">CS301</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Upcoming Deadlines -->
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-900">Upcoming Deadlines</h3>
                                <i class="fas fa-exclamation-triangle text-orange-400"></i>
                            </div>
                            <div class="space-y-4">
                                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Assignment: Web Development Project</p>
                                        <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">CS301</span>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-medium text-gray-900">Tomorrow</p>
                                        <span class="px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full">high</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        const mobileOverlay = document.getElementById('mobile-overlay');
        const closeSidebar = document.getElementById('close-sidebar');

        function openSidebar() {
            mobileOverlay.classList.remove('hidden');
            sidebar.classList.remove('-translate-x-full');
        }

        function closeSidebarFunc() {
            sidebar.classList.add('-translate-x-full');
            mobileOverlay.classList.add('hidden');
        }

        mobileMenuBtn.addEventListener('click', openSidebar);
        closeSidebar.addEventListener('click', closeSidebarFunc);
        mobileOverlay.addEventListener('click', closeSidebarFunc);

        // Close sidebar when clicking on a link (mobile only)
        const sidebarLinks = sidebar.querySelectorAll('nav a');
        sidebarLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 1024) { // Only on mobile
                    closeSidebarFunc();
                }
            });
        });

        // Dropdown functionality
        const notificationBtn = document.getElementById('notification-btn');
        const notificationDropdown = document.getElementById('notification-dropdown');
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        // Toggle notification dropdown
        notificationBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            notificationDropdown.classList.toggle('hidden');
            profileDropdown.classList.add('hidden');
        });

        // Toggle profile dropdown
        profileBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            profileDropdown.classList.toggle('hidden');
            notificationDropdown.classList.add('hidden');
        });

        // Close dropdowns when clicking outside
        document.addEventListener('click', function() {
            notificationDropdown.classList.add('hidden');
            profileDropdown.classList.add('hidden');
        });

        // Prevent dropdown from closing when clicking inside
        notificationDropdown.addEventListener('click', function(e) {
            e.stopPropagation();
        });
        profileDropdown.addEventListener('click', function(e) {
            e.stopPropagation();
        });

        // Charts
        window.addEventListener('load', function() {
            // Weekly Attendance Chart
            const attendanceCtx = document.getElementById('attendanceChart').getContext('2d');
            new Chart(attendanceCtx, {
                type: 'bar',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
                    datasets: [{
                        data: [85, 92, 78, 88, 95],
                        backgroundColor: '#3B82F6',
                        borderRadius: 4,
                        borderSkipped: false,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                stepSize: 25
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });

            // Course Distribution Chart
            const courseCtx = document.getElementById('courseChart').getContext('2d');
            new Chart(courseCtx, {
                type: 'doughnut',
                data: {
                    labels: ['CS101', 'CS201', 'CS301', 'CS401'],
                    datasets: [{
                        data: [40, 25, 20, 15],
                        backgroundColor: ['#3B82F6', '#10B981', '#EAB308', '#8B5CF6'],
                        borderWidth: 0,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    cutout: '60%'
                }
            });
        });
    </script>
</body>
</html>
