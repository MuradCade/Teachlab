<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeachLab | Teacher - Update Student Information</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/assets/css/mdb.min.css">
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/allmin.css">
    <link rel="stylesheet" href="/assets/css/fontawesome.css">
    <link rel="stylesheet" href="/assets/css/toastcolors.css">
    <link rel="shortcut icon" href="/assets/img/favicon.png" type="image/x-icon">

    
    <!-- Chart.js -->
    <script src="/assets/js/chart.js"></script>
      <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
      </style>
</head>
<body>

    <!-- Added sidebar overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <!-- Sidebar -->
   {%include 'teacher/templates/sidebar.twig'%}


    <!-- Main Content -->
    <div class="main-content">
        <!-- Made header fixed and added mobile menu toggle -->
        <nav class="navbar fixed-top-navbar px-4 shadow-sm">
            <div class="container-fluid">
                <button class="btn btn-outline-secondary mobile-menu-toggle me-3" id="mobileMenuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="d-flex align-items-center ms-auto">
                      {%include 'teacher/templates/topbar.twig'%}

                </div>
            </div>
        </nav>

             <div class="container-fluid p-4">
            <div class="row mb-4">

                <div class="col-lg-6 col-md-8 col-sm-12">
                     
                     <div class="card metric-card  shadow-sm">
                        <h4 class="card-header" style='font-size:15px !important;color:black!important;'>
                            Update Student Information
                        </h4>
                        <div class="card-body">
                            {%if errors %}

                            {%if errors['csrf_token']%}
                            {{ toast.dangerToast(errors['csrf_token'])|raw }}
                            {% endif %}

                            {%if errors['studentname']%}
                            {{ toast.dangerToast(errors['studentname'])|raw }}
                            {% endif %}

                            {%if errors['studentid']%}
                            {{ toast.dangerToast(errors['studentid'])|raw }}
                            {% endif %}

                            {%if errors['coursename']%}
                            {{ toast.dangerToast(errors['coursename'])|raw }}
                            {% endif %}

                            {%if errors['success']%}
                            {{ toast.successToast(errors['success'])|raw }}
                            {% endif %}

                            {%endif%}
                            <form action="{{url_for('teacher.student.student_edit.index.submit',{studentid:studentdata.id})}}" method='POST'>
                            <input type="hidden" name='csrf_token' value="{{csrf_token}}">
                                <div class="form-group">
                                    <label for="studentid" class='form-label' style='font-size:14px;color:black!important;'>Student ID</label>
                                    <input type="number" id='studentid' name='studentid' class='form-control' placeholder='Enter Student ID' value="{{studentdata.id}}" style='font-size:14px !important;'>
                                </div>
                                 <div class="form-group mt-2">
                                    <label for="studentfullname" class='form-label' style='font-size:14px;color:black!important;'>Student Fullname</label>
                                    <input type="text" id='studentfullname' name='studentname' class='form-control' placeholder='Enter Student Fullname' value="{{studentdata.studentname}}" style='font-size:14px !important;'>
                                </div>
                                 <div class="form-group mt-2">
                                    <label for="coursename" class='form-label' style='font-size:14px;color:black!important;'>Course Name</label>

                                    <select id='coursename' name='coursename' class='form-select' style='font-size:14px !important;'>
                                        {% for coursedata in coursemodel%}
                                        <option value="{{coursedata.id}}" {{coursedata.id == studentdata.courseid ? 'selected':''}}>{{coursedata.coursename}}</option>
                                        {%else%}
                                        {%endfor%}
                                    </select>

                                    <button class='btn btn-primary btn-sm text-capitalize shadow-0 mt-3 fw-bold' style='font-size:13px;'>Update</button>
                                    <a href="{{url_for('teacher.student.index')}}" class='btn btn-secondary btn-sm text-capitalize shadow-0 mt-3 fw-bold' style='font-size:13px;'>Go Back</a>
                                </div>
                                
                                
                            </form>
                        </div>
                     </div>
                </div>
            </div>
            </div>
    </div>
 <!-- MDB Bootstrap JS -->
    <script src="/assets/js/mdb.min.js"></script>
    <script>
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('show');
            sidebarOverlay.classList.toggle('show');
        });
        
        sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('show');
            sidebarOverlay.classList.remove('show');
        });
    </script>
</body>
</html>

