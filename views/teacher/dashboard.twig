<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeachLab Dashboard</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/assets/css/mdb.min.css">
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/allmin.css">
    <link rel="stylesheet" href="/assets/css/fontawesome.css">

    
    <!-- Chart.js -->
    <script src="/assets/js/chart.js"></script>
      <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
      </style>
</head>
<body>
    <!-- Added sidebar overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="p-3">
            <h4 class="navbar-brand">
                <img src="/assets/img/logo.png" alt="teachlab logo" width='140' >
            </h4>
        </div>
        
        <nav class="nav flex-column gap-0">
            <a class="nav-link font-md active" href="#">
                <i class="fas fa-th-large me-2"></i> Dashboard
            </a>
            <a class="nav-link font-md" href="#">
                <i class="fas fa-book me-2"></i> Courses
            </a>
            <a class="nav-link font-md" href="#">
                <i class="fas fa-users me-2"></i> Students
            </a>
            <a class="nav-link font-md" href="#">
                <i class="fas fa-calendar-check me-2"></i> Attendance
            </a>
            <a class="nav-link font-md" href="#">
                <i class="fas fa-tasks me-2"></i> Assignments
            </a>
            <a class="nav-link font-md" href="#">
                <i class="fas fa-question-circle me-2"></i> Quizzes
            </a>
            <a class="nav-link font-md" href="#">
                <i class="fas fa-file-alt me-2"></i> Exams
            </a>
        </nav>
        
        <!-- Upgrade Card -->
        <div class="upgrade-card p-3  mt-2" style='position:relative; right:2px;'>
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-crown me-2"></i>
                <strong>Upgrade to Pro</strong>
            </div>
            <p class="small mb-3">Unlock advanced features and analytics</p>
            <button class="btn btn-light btn-sm w-100">Upgrade Now</button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Made header fixed and added mobile menu toggle -->
        <nav class="navbar fixed-top-navbar px-4 shadow-sm">
            <div class="container-fluid">
                <button class="btn btn-outline-secondary mobile-menu-toggle me-3" id="mobileMenuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="d-flex align-items-center ms-auto">
                    <!-- Added notification dropdown -->
                    <div class="dropdown me-3">
                        <button class="btn btn-link position-relative p-0" type="button" id="notificationDropdown" data-mdb-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-bell text-muted" style="font-size: 20px;"></i>
                            <span class="notification-badge">3</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationDropdown" style="width: 300px;">
                            <li><h6 class="dropdown-header">Notifications</h6></li>
                            <li><a class="dropdown-item" href="#">
                                <div class="d-flex align-items-start">
                                    <div class="me-3">
                                        <i class="fas fa-user-plus text-success"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">New Student Enrolled</div>
                                        <small class="text-muted">John Doe joined Computer Science 101</small>
                                        <div class="text-muted small">2 minutes ago</div>
                                    </div>
                                </div>
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">
                                <div class="d-flex align-items-start">
                                    <div class="me-3">
                                        <i class="fas fa-tasks text-warning"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Assignment Due Soon</div>
                                        <small class="text-muted">Math Assignment due in 2 hours</small>
                                        <div class="text-muted small">1 hour ago</div>
                                    </div>
                                </div>
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">
                                <div class="d-flex align-items-start">
                                    <div class="me-3">
                                        <i class="fas fa-chart-line text-info"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Weekly Report Ready</div>
                                        <small class="text-muted">Your attendance report is available</small>
                                        <div class="text-muted small">3 hours ago</div>
                                    </div>
                                </div>
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-center" href="#">View All Notifications</a></li>
                        </ul>
                    </div>
                    
                    <!-- Added user profile dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-link d-flex align-items-center p-0 text-decoration-none" type="button" id="userDropdown" data-mdb-toggle="dropdown" aria-expanded="false">
                            <div class="profile-avatar me-2">DS</div>
                            <div class="text-start">
                                <div class="fw-bold text-dark">Dr. Smith</div>
                                <small class="text-muted">Computer Science</small>
                            </div>
                            <i class="fas fa-chevron-down ms-2 text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><h6 class="dropdown-header">Dr. Smith</h6></li>
                            <li><a class="dropdown-item" href="#">
                                <i class="fas fa-user me-2"></i>Profile
                            </a></li>
                            <li><a class="dropdown-item" href="#">
                                <i class="fas fa-cog me-2"></i>Settings
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#">
                                <i class="fas fa-sign-out-alt me-2"></i>Sign Out
                            </a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Dashboard Content -->
        <div class="container-fluid p-4">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="mb-1 font-lg" >Dashboard Overview</h2>
                    <p class="text-muted mb-0 font-sm">Monitor your teaching activities and student progress</p>
                </div>
               <!-- <div class="text-end">
                    <small class="text-muted">Last updated</small>
                    <div class="fw-bold">Today, 2:30 PM</div>
                </div> -->
            </div>

            <!-- Metrics Cards -->
            <div class="row mb-4">
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card metric-card h-80 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            
                            <div class="flex-grow-1">
                                <div class="text-muted small">Total Courses</div>
                                <div class="h3 mb-0">8</div>
                            </div>
                            <div class="me-3">
                                <div class="metric-icon" style="background-color: #4285f4;">
                                    <i class="fas fa-book"></i> 
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card metric-card h-80 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-muted small">Total Students</div>
                                <div class="h3 mb-0">245</div>
                            </div>
                                <div class="me-3">
                                    <div class="metric-icon" style="background-color: #34a853;">
                                        <i class="fas fa-users"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card metric-card h-80 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-muted small">Total Assignments</div>
                                <div class="h3 mb-0">12</div>
                            </div>
                            <div class="me-3">
                                <div class="metric-icon" style="background-color: #ff9800;">
                                    <i class="fas fa-tasks"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card metric-card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-muted small">Avg Attendance</div>
                                <div class="h3 mb-0">87%</div>
                            </div>
                             <div class="me-3">
                                <div class="metric-icon" style="background-color: #9c27b0;">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="row">
                <div class="col-lg-8 mb-4">
                    <div class="chart-container">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-md">Weekly Attendance Trend</h5>
                            <i class="fas fa-chart-line text-success"></i>
                        </div>
                        <!-- Added chart wrapper with fixed height -->
                        <div class="chart-wrapper">
                            <canvas id="attendanceChart"></canvas>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 mb-4">
                    <div class="chart-container">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-md">Course Distribution</h5>
                            <i class="fas fa-chart-pie text-primary"></i>
                        </div>
                        <!-- Added chart wrapper with fixed height -->
                        <div class="chart-wrapper">
                            <canvas id="courseChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Activities Row -->
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm" style="border-radius: 12px; border: 1px solid #e9ecef;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0 font-md">Recent Activities</h5>
                                <div class="bg-light rounded-circle p-2">
                                    <i class="fas fa-clock text-muted"></i>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-start">
                                <div class="me-3">
                                    <div class="bg-primary rounded-circle p-2" style="width: 8px; height: 8px;"></div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold mb-1">New submission for "Database Design Project"</div>
                                    <div class="d-flex align-items-center">
                                        <small class="text-muted me-2">2 hours ago</small>
                                        <span class="badge bg-light text-primary" style="font-size: 11px;">CS301</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm" style="border-radius: 12px; border: 1px solid #e9ecef;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0 font-md">Upcoming Deadlines</h5>
                                <div class="bg-light rounded-circle p-2">
                                    <i class="fas fa-exclamation-triangle text-warning"></i>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="flex-grow-1">
                                    <div class="fw-bold mb-1">Assignment: Web Development Project</div>
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-light text-primary me-2" style="font-size: 11px;">CS301</span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold">Tomorrow</div>
                                    <span class="badge bg-danger text-white" style="font-size: 10px;">high</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MDB Bootstrap JS -->
    <script src="/assets/js/mdb.js"></script>
    
    <script>
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('show');
            sidebarOverlay.classList.toggle('show');
        });
        
        sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('show');
            sidebarOverlay.classList.remove('show');
        });
        
        // Weekly Attendance Chart
        const attendanceCtx = document.getElementById('attendanceChart').getContext('2d');
        new Chart(attendanceCtx, {
            type: 'bar',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
                datasets: [{
                    data: [85, 92, 78, 88, 95],
                    backgroundColor: '#4285f4',
                    borderRadius: 4,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            stepSize: 25
                        },
                        grid: {
                            color: '#f0f0f0'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Course Distribution Chart
        const courseCtx = document.getElementById('courseChart').getContext('2d');
        new Chart(courseCtx, {
            type: 'doughnut',
            data: {
                labels: ['Computer Science', 'Mathematics', 'Physics', 'Chemistry'],
                datasets: [{
                    data: [40, 25, 20, 15],
                    backgroundColor: ['#4285f4', '#34a853', '#ff9800', '#9c27b0'],
                    borderWidth: 0,
                    cutout: '60%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>
